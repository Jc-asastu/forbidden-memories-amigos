{
  "name": "forbidden-memories-amigos",
  "version": "0.7.0",
  "private": true,
  "description": "Perfiles locales y salas entre amigos para Forbidden Memories Recompiled",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.cjs",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win nsis --x64",
    "prepare:vendor": "node scripts/fetch-dependencies.cjs"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.8.1"
  },
  "author": "FM Amigos",
  "build": {
    "appId": "com.fmamigos.game",
    "productName": "Forbidden Memories Amigos",
    "directories": {
      "output": "../../work/installer-build",
      "buildResources": "assets"
    },
    "files": [
      "desktop/**/*",
      "shared/**/*",
      "server/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json",
      "CREDITOS.md",
      "LICENSE",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "cloudflared.exe",
          "CLOUDFLARED-LICENSE",
          "ygofm-setup-0.5.9.zip",
          "pillow-312.zip"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app.ico",
      "artifactName": "Forbidden-Memories-Amigos-Setup-${version}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/app.ico",
      "uninstallerIcon": "assets/app.ico",
      "installerLanguages": [
        "es_ES"
      ],
      "displayLanguageSelector": false,
      "runAfterFinish": true,
      "include": "assets/installer.nsh"
    }
  }
}
